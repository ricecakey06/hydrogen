{
  "name": "hydrogen-launcher",
  "private": true,
  "version": "0.2.12",
  "type": "module",
  "scripts": {
    "dev": "npm run build:plugins && vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:motion": "node --test tests/motion.test.ts",
    "test:selection": "node --test tests/mod-selection.test.ts",
    "test:downloads": "node --test tests/downloads.test.ts",
    "test:avatar": "node --test tests/avatar.test.ts",
    "build": "npm run check && npm run build:plugins && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 dev",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 release",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 test",
    "build:plugins": "node scripts/build-plugin-ui.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
