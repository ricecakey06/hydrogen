{
  "schemaVersion": 2,
  "apiVersion": 1,
  "id": "minecraft.preinstall",
  "name": "游戏预安装",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "bin/plugin.dll",
  "permissions": [
    "native.code"
  ],
  "dependencies": [
    {
      "id": "minecraft.content",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.files",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.download",
      "version": "^1",
      "optional": true
    },
    {
      "id": "network",
      "version": "^1",
      "optional": false
    },
    {
      "id": "platform.windows.environment",
      "version": "^1"
    }
  ],
  "provides": [
    {
      "id": "minecraft.preinstall",
      "version": "1.0.0",
      "methods": [
        "prepare",
        "poll",
        "cancel"
      ]
    }
  ]
}
