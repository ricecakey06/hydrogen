{
  "schemaVersion": 2,
  "apiVersion": 1,
  "id": "account.manager",
  "name": "账号管理",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "bin/plugin.dll",
  "permissions": [
    "native.code"
  ],
  "dependencies": [
    {
      "id": "account.offline",
      "version": "^1",
      "optional": true
    },
    {
      "id": "account.microsoft",
      "version": "^1",
      "optional": true
    }
  ],
  "provides": [
    {
      "id": "account.manager",
      "version": "1.0.0",
      "methods": [
        "view",
        "reset",
        "signOut",
        "signIn",
        "session",
        "poll",
        "cancel",
        "failure",
        "profiles.list",
        "profiles.hasCredentials",
        "profiles.addOffline",
        "profiles.select",
        "profiles.delete"
      ]
    }
  ]
}
