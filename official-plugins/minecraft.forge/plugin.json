{
  "schemaVersion": 2,
  "apiVersion": 1,
  "id": "minecraft.forge",
  "name": "Forge / NeoForge 安装",
  "description": "查找兼容的 Forge 和 NeoForge 版本，并在安装实例时准备所选加载器。",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "bin/plugin.dll",
  "permissions": [
    "native.code"
  ],
  "dependencies": [
    {
      "id": "minecraft.content",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.instances",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.preinstall",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.files",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.download",
      "version": "^1",
      "optional": true
    },
    {
      "id": "network",
      "version": "^1",
      "optional": false
    },
    {
      "id": "java.runtime",
      "version": "^1",
      "optional": false
    },
    {
      "id": "process",
      "version": "^1",
      "optional": false
    }
  ],
  "provides": [
    {
      "id": "minecraft.forge",
      "version": "1.0.0",
      "methods": [
        "options",
        "prepare",
        "poll",
        "cancel"
      ]
    }
  ]
}
