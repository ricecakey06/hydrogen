{
  "schemaVersion": 3,
  "apiVersion": 1,
  "id": "minecraft.download",
  "name": "minecraft.download",
  "description": "按下载源设置传输游戏文件，报告进度并支持取消下载。",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "bin/plugin.dll",
  "permissions": [
    "native.code"
  ],
  "dependencies": [
    {
      "id": "network",
      "version": "^1"
    }
  ],
  "provides": [
    {
      "id": "minecraft.download",
      "version": "1.0.0",
      "methods": [
        "transfer",
        "once",
        "sourceUrl",
        "trusted",
        "poll",
        "cancel"
      ]
    }
  ],
  "contributes": {
    "providers": [
      {
        "id": "official",
        "kind": "downloadSource",
        "title": "官方源（Mojang）",
        "service": "minecraft.download",
        "version": "1.0.0"
      },
      {
        "id": "bmclapi",
        "kind": "downloadSource",
        "title": "BMCLAPI（bangbang93）",
        "service": "minecraft.download",
        "version": "1.0.0"
      }
    ]
  }
}
