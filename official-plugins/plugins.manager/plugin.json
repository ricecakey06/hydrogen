{
  "schemaVersion": 2,
  "apiVersion": 1,
  "id": "plugins.manager",
  "name": "插件管理",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "bin/plugin.dll",
  "permissions": [
    "native.code",
    "ui.host"
  ],
  "dependencies": [
    {
      "id": "ui.shell",
      "version": "^1",
      "optional": true
    },
    {
      "id": "ui.launcher",
      "version": "^1",
      "optional": true
    }
  ],
  "frontend": {
    "entry": "assets/manager.js",
    "styles": [
      "assets/manager.css"
    ]
  }
}
