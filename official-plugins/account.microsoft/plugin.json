{
  "schemaVersion": 3,
  "apiVersion": 1,
  "id": "account.microsoft",
  "name": "Microsoft 账号",
  "description": "通过 Microsoft 账号登录 Minecraft，验证游戏资格并恢复已保存的登录会话。",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "bin/plugin.dll",
  "permissions": [
    "native.code"
  ],
  "dependencies": [
    {
      "id": "network",
      "version": "^1"
    },
    {
      "id": "credentials",
      "version": "^1"
    },
    {
      "id": "platform.windows.environment",
      "version": "^1"
    }
  ],
  "provides": [
    {
      "id": "account.microsoft",
      "version": "1.0.0",
      "methods": [
        "view",
        "reset",
        "signOut",
        "signIn",
        "session",
        "poll",
        "cancel",
        "failure",
        "callback",
        "forget"
      ]
    }
  ],
  "contributes": {
    "providers": [
      {
        "id": "microsoft",
        "kind": "accountProvider",
        "title": "微软账号",
        "service": "account.microsoft",
        "version": "1.0.0"
      }
    ]
  }
}
