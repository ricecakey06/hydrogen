{
  "schemaVersion": 2,
  "apiVersion": 1,
  "id": "minecraft.mods",
  "name": "模组管理",
  "description": "扫描实例中的模组，支持导入、启停、修改显示名称和删除。",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "bin/plugin.dll",
  "permissions": [
    "native.code"
  ],
  "provides": [
    {
      "id": "minecraft.mods",
      "version": "1.0.0",
      "methods": [
        "inventory",
        "readArchive",
        "enable",
        "remove",
        "name",
        "read",
        "close",
        "importBegin",
        "importAdd",
        "importCommit",
        "importAbort"
      ]
    }
  ]
}