{
  "schemaVersion": 2,
  "apiVersion": 1,
  "id": "diagnostics",
  "name": "诊断日志",
  "description": "记录游戏运行日志，限制日志大小并隐藏已知的敏感信息。",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "bin/plugin.dll",
  "permissions": [
    "native.code"
  ],
  "provides": [
    {
      "id": "diagnostics",
      "version": "1.0.0",
      "methods": [
        "create",
        "append",
        "close"
      ]
    }
  ]
}
