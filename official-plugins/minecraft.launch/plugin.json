{
  "schemaVersion": 2,
  "apiVersion": 1,
  "id": "minecraft.launch",
  "name": "游戏启动",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "bin/plugin.dll",
  "permissions": [
    "native.code"
  ],
  "dependencies": [
    {
      "id": "minecraft.crash",
      "version": "^1",
      "optional": true
    },
    {
      "id": "account.manager",
      "version": "^1"
    },
    {
      "id": "minecraft.content",
      "version": "^1"
    },
    {
      "id": "minecraft.instances",
      "version": "^1"
    },
    {
      "id": "minecraft.preinstall",
      "version": "^1"
    },
    {
      "id": "java.runtime",
      "version": "^1"
    },
    {
      "id": "storage",
      "version": "^1"
    },
    {
      "id": "process",
      "version": "^1"
    },
    {
      "id": "diagnostics",
      "version": "^1"
    }
  ],
  "provides": [
    {
      "id": "minecraft.launch",
      "version": "1.0.0",
      "methods": [
        "launch",
        "arguments",
        "extract",
        "poll",
        "cancel"
      ]
    }
  ]
}
