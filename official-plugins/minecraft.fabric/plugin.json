{
  "schemaVersion": 3,
  "apiVersion": 1,
  "id": "minecraft.fabric",
  "name": "Fabric 快捷安装",
  "description": "查找兼容的 Fabric Loader 和 Fabric API，并在安装实例时配置所选组件。",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "bin/plugin.dll",
  "permissions": [
    "native.code"
  ],
  "dependencies": [
    {
      "id": "minecraft.content",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.files",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.download",
      "version": "^1",
      "optional": true
    },
    {
      "id": "network",
      "version": "^1",
      "optional": false
    }
  ],
  "provides": [
    {
      "id": "minecraft.fabric",
      "version": "1.0.0",
      "methods": [
        "options",
        "prepare",
        "poll",
        "cancel"
      ]
    }
  ],
  "contributes": {
    "providers": [
      {
        "id": "fabric",
        "kind": "loaderProvider",
        "title": "Fabric",
        "service": "minecraft.fabric",
        "version": "1.0.0"
      },
      {
        "id": "quilt",
        "kind": "loaderProvider",
        "title": "Quilt",
        "service": "minecraft.fabric",
        "version": "1.0.0"
      }
    ]
  }
}
