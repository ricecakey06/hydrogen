{
  "schemaVersion": 2,
  "apiVersion": 1,
  "id": "minecraft.install",
  "name": "游戏安装",
  "description": "创建并安装所选 Minecraft 版本，配置模组加载器，也可修复已有实例。",
  "version": "1.0.0",
  "runtime": "native",
  "entry": "bin/plugin.dll",
  "permissions": [
    "native.code"
  ],
  "dependencies": [
    {
      "id": "minecraft.content",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.instances",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.preinstall",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.fabric",
      "version": "^1",
      "optional": true
    },
    {
      "id": "storage",
      "version": "^1",
      "optional": false
    },
    {
      "id": "minecraft.forge",
      "version": "^1",
      "optional": true
    }
  ],
  "provides": [
    {
      "id": "minecraft.install",
      "version": "1.0.0",
      "methods": [
        "install",
        "create",
        "poll",
        "cancel"
      ]
    }
  ]
}
