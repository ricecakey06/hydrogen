{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydrogen.local/theme/v1",
  "title": "Hydrogen declarative theme v1",
  "$defs": {
    "asset": { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "type": "string" } } },
    "choice": { "type": "object", "additionalProperties": false, "required": ["id", "mode", "material"], "properties": { "id": { "type": "string", "maxLength": 205 }, "mode": { "enum": ["light", "dark", "system"] }, "material": { "enum": ["auto", "opaque"] } } },
    "contribution": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "themeVersion", "variants"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,99}$" }, "title": { "type": "string", "maxLength": 200 }, "themeVersion": { "const": 1 },
        "variants": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "light": { "type": "string" }, "dark": { "type": "string" } } },
        "preview": { "type": ["string", "null"] }
      }
    }
  },
  "type": "object", "additionalProperties": false, "required": ["themeVersion", "scheme", "extends", "styles"],
  "properties": {
    "themeVersion": { "const": 1 }, "scheme": { "enum": ["light", "dark"] }, "extends": { "enum": ["builtin.light.v1", "builtin.dark.v1"] },
    "styles": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
    "panelStyles": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
    "branding": { "type": "object", "additionalProperties": false, "properties": { "logo": { "oneOf": [{ "$ref": "#/$defs/asset" }, { "type": "null" }] } } },
    "layers": { "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["id", "slot", "source"], "properties": { "id": { "type": "string" }, "source": { "type": "string" }, "slot": { "enum": ["window.background", "content.background", "sidebar.background", "titlebar.decoration", "sidebar.decoration", "content.decoration"] } } } }
  }
}
