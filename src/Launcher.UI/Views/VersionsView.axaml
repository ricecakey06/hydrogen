<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.UI.ViewModels"
             xmlns:motion="using:Launcher.UI.Motion"
             x:Class="Launcher.UI.Views.VersionsView"
             x:ClassModifier="internal"
             x:DataType="vm:VersionsViewModel">
  <Panel Margin="24,0,24,24">
    <!-- Added versions -->
    <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding !IsAdding}" motion:Motion.EntranceDelay="0">
      <StackPanel>
        <TextBlock Classes="section" Text="已安装实例" Margin="2,12,0,10" />
        <TextBlock Classes="issue" Text="{Binding ActionError}" Margin="2,0,0,10"
                   IsVisible="{Binding ActionError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
      <ScrollViewer Grid.Row="1" IsVisible="{Binding HasInstances}">
        <ItemsControl ItemsSource="{Binding Instances}" Margin="2,2,14,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InstanceItem">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <Button Theme="{StaticResource FlatButton}" Command="{Binding Select}" Height="64"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="{Binding Name}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{Binding Name}" FontSize="18" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Text="{Binding GameVersion}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="当前实例" IsVisible="{Binding IsSelected}" FontSize="14" Margin="12,0,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
                </Button>
                <Button Grid.Column="1" Theme="{StaticResource IconButton}" Command="{Binding ShowSettings}"
                        Width="44" Height="44" Margin="10,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.Name="实例设置" ToolTip.Tip="实例设置">
                  <Path Data="M3,5 H21 M3,12 H21 M3,19 H21 M8,2 V8 M16,9 V15 M9,16 V22"
                        Width="22" Height="22" Stretch="Uniform" Stroke="{DynamicResource IconBrush}"
                        StrokeThickness="2" StrokeLineCap="Round" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Grid.Row="1" Text="还没有安装完成的实例" IsVisible="{Binding !HasInstances}" FontSize="16"
                 Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Button Grid.Row="2" Theme="{StaticResource FlatButton}" Content="添加版本" Command="{Binding ShowAdd}"
              Height="44" HorizontalAlignment="Stretch" Margin="2,12,14,0" />
    </Grid>

    <!-- Official versions -->
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsChoosingVersion}" motion:Motion.EntranceDelay="0">
      <TextBlock Classes="section" Text="选择游戏版本" Margin="2,12,0,10" />
      <StackPanel Grid.Row="1" Spacing="14" IsVisible="{Binding IsLoading}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="200" />
        <TextBlock Text="正在获取版本列表" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="issue" Text="{Binding LoadError}" HorizontalAlignment="Center" />
        <Button Theme="{StaticResource FlatButton}" Content="重试" Command="{Binding LoadCatalog}"
                Width="120" HorizontalAlignment="Center" />
      </StackPanel>
      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding Available}" Margin="2,2,14,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VersionItem">
              <Button Theme="{StaticResource FlatButton}" Command="{Binding Configure}"
                      Height="48" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="{Binding Id}" motion:Motion.EntranceDelay="0">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Id}" FontSize="18" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="配置实例 ›" FontSize="14"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Instance setup. Loader pre-installation contracts live in Launcher.Contracts. -->
    <Grid RowDefinitions="*,Auto" IsVisible="{Binding IsConfiguring}" IsEnabled="{Binding !IsBusy}"
          motion:Motion.EntranceDelay="0">
      <ScrollViewer>
        <StackPanel Margin="2,0,14,16">
          <TextBlock Classes="section" Text="游戏版本" />
          <TextBlock Text="{Binding SelectedVersion}" FontSize="22" />
          <TextBlock Classes="section" Text="实例名称" />
          <TextBox Text="{Binding NewInstanceName, Mode=TwoWay}" MaxLength="64" AutomationProperties.Name="新实例名称"
                   PlaceholderText="例如：生存存档、多人服务器" />
          <TextBlock Classes="caption" Text="同一游戏版本可以创建多个实例，请使用不同名称。每个实例拥有独立的存档、模组和设置。" />
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="1" Margin="2,12,14,0" Spacing="12">
        <TextBlock Classes="issue" Text="{Binding ActionError}"
                   IsVisible="{Binding ActionError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Theme="{StaticResource FlatButton}" Content="开始安装" Command="{Binding StartInstallation}"
                HorizontalAlignment="Stretch" Height="48" />
      </StackPanel>
    </Grid>
  </Panel>
</UserControl>
