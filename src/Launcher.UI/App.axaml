<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Launcher.UI.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#FF34373C" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Launcher.UI/Styles/Theme.axaml" />
    <StyleInclude Source="avares://Launcher.UI/Styles/Motion.axaml" />
    <StyleInclude Source="avares://Launcher.UI/Styles/Plugins.axaml" />
  </Application.Styles>
</Application>
